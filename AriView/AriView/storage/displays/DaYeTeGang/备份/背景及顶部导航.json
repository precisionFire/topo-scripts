    "onPostDeserialize": "__ht__function(json, dm, view, datas) {// SteelFactStore（事实仓库）\r\nconst SteelFactStore = {\r\n    initialized: false,\r\n    data: {},\r\n\r\n    load() {\r\n        const cache = localStorage.getItem('SteelFactStore');\r\n\r\n        if (!cache) return;\r\n\r\n        try {\r\n            const obj = JSON.parse(cache);\r\n\r\n            this.initialized = obj.initialized || false;\r\n            this.data = obj.data || {};\r\n\r\n            console.log('[SteelFactStore] 恢复成功');\r\n        } catch (err) {\r\n            console.error('[SteelFactStore] 恢复失败', err);\r\n        }\r\n    },\r\n\r\n    save() {\r\n        localStorage.setItem(\r\n            'SteelFactStore',\r\n            JSON.stringify({\r\n                initialized: this.initialized,\r\n                data: this.data\r\n            })\r\n        );\r\n    }\r\n};\r\n\r\n// SteelStateStore（运动状态仓库）\r\nconst SteelStateStore = {\r\n    data: {},\r\n\r\n    load() {\r\n        const cache = localStorage.getItem('SteelStateStore');\r\n\r\n        if (!cache) return;\r\n\r\n        try {\r\n            this.data = JSON.parse(cache);\r\n\r\n            console.log('[SteelStateStore] 恢复成功');\r\n        } catch (err) {\r\n            console.error('[SteelStateStore] 恢复失败', err);\r\n        }\r\n    },\r\n\r\n    save() {\r\n        localStorage.setItem(\r\n            'SteelStateStore',\r\n            JSON.stringify(this.data)\r\n        );\r\n    }\r\n};\r\n\r\n//缓存仓库初始化\r\nSteelFactStore.load();\r\nSteelStateStore.load();\r\n\r\n//速度初始化配置\r\nconst SPEED_CONFIG = {\r\n    default: 100,\r\n\r\n    rough: 80,\r\n\r\n    middle: 120,\r\n\r\n    preFinish: 180,\r\n\r\n    finish: 250\r\n};\r\n\r\n//实时速度匹配\r\nfunction getSteelSpeed(headX) {\r\n\r\n    if (headX >= 3380 && headX <= 3550) {\r\n        return SPEED_CONFIG.finish;\r\n    }\r\n\r\n    if (headX >= 1600 && headX <= 1800) {\r\n        return SPEED_CONFIG.preFinish;\r\n    }\r\n\r\n    if (headX >= 1100 && headX <= 1500) {\r\n        return SPEED_CONFIG.middle;\r\n    }\r\n\r\n    if (headX >= 320 && headX <= 630) {\r\n        return SPEED_CONFIG.rough;\r\n    }\r\n\r\n    return SPEED_CONFIG.default;\r\n}\r\n\r\n//事件：轧线新增钢坯\r\nfunction addSteelToState(item) {\r\n\r\n    if (SteelStateStore.data[item.slabNo]) {\r\n        return;\r\n    }\r\n\r\n    SteelStateStore.data[item.slabNo] = {\r\n\r\n        slabNo: item.slabNo,\r\n\r\n        cardNo: item.cardNo,\r\n\r\n        headX: 0,\r\n\r\n        tailX: 0,\r\n\r\n        length: 0,\r\n\r\n        createTime: Date.now(),\r\n\r\n        updateTime: Date.now()\r\n    };\r\n\r\n    console.log(\r\n        '[钢坯进入轧线]',\r\n        item.slabNo\r\n    );\r\n}\r\n\r\n//建立事实基线\r\nfunction buildFactBaseline(rawData) {\r\n\r\n    rawData.forEach(item => {\r\n\r\n        SteelFactStore.data[item.slabNo] = {\r\n            ...item,\r\n            updateTime: Date.now()\r\n        };\r\n\r\n    });\r\n\r\n    SteelFactStore.initialized = true;\r\n\r\n    SteelFactStore.save();\r\n\r\n    console.log(\r\n        '[FactStore] 基线建立完成'\r\n    );\r\n}\r\n\r\n//更新真实数据仓库\r\nfunction updateFactStore(rawData) {\r\n\r\n    rawData.forEach(item => {\r\n\r\n        const slabNo = item.slabNo;\r\n\r\n        if (!SteelFactStore.data[slabNo]) {\r\n\r\n            addSteelToState(item);\r\n        }\r\n\r\n        SteelFactStore.data[slabNo] = {\r\n            ...item,\r\n            updateTime: Date.now()\r\n        };\r\n    });\r\n\r\n    SteelFactStore.save();\r\n}\r\n\r\n//运算推演核心\r\nfunction updateSteelStates() {\r\n\r\n    const now = Date.now();\r\n\r\n    Object.values(\r\n        SteelStateStore.data\r\n    ).forEach(steel => {\r\n\r\n        const dt =\r\n            (now - steel.updateTime)\r\n            / 1000;\r\n\r\n        steel.updateTime = now;\r\n\r\n        const speed =\r\n            getSteelSpeed(\r\n                steel.headX\r\n            );\r\n\r\n        // 头部前进\r\n        steel.headX += speed * dt;\r\n\r\n        // 长度增长\r\n        if (steel.length < 150) {\r\n\r\n            steel.length += speed * dt;\r\n\r\n            if (steel.length > 150) {\r\n                steel.length = 150;\r\n            }\r\n        }\r\n\r\n        steel.tailX =\r\n            steel.headX - steel.length;\r\n\r\n        if (steel.tailX < 0) {\r\n            steel.tailX = 0;\r\n        }\r\n\r\n    });\r\n}\r\n\r\n//接入flow\r\nfunction buildRenderData() {\r\n\r\n    return Object.values(\r\n        SteelStateStore.data\r\n    ).map(steel => [\r\n\r\n        steel.slabNo,\r\n\r\n        steel.cardNo,\r\n\r\n        steel.headX,\r\n\r\n        steel.tailX\r\n\r\n    ]);\r\n}\r\n\r\n//启动运行模型\r\nfunction startSteelSimulator() {\r\n\r\n    setInterval(() => {\r\n\r\n        updateSteelStates();\r\n\r\n        renderMultipleSteels(\r\n            buildRenderData()\r\n        );\r\n\r\n        SteelStateStore.save();\r\n\r\n    }, 100);\r\n}}"
  },
